{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main/mcp.ts",
    "src/main/cli.ts",
    "src/main/mcpDoctor.ts",
    "src/main/mcpHttpEntry.ts",
    "src/agent/index.ts",
    "scripts/*.mjs",
    "scripts/lib/*.mjs",
    "tests/support/**/*.ts"
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"],
  "ignoreDependencies": ["@types/frida-gum"],
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error"
  },
  "ignoreExportsUsedInFile": true
}
